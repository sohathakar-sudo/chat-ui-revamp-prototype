{
  "name": "wysa-chat-revamp-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"node --env-file-if-exists=.env --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "typescript": "5.7",
    "vite": "^6.4.6"
  }
}
